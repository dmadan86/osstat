{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osstat.dev/schemas/runtimes.schema.json",
  "title": "osstat pinned llama.cpp runtime manifest",
  "description": "The set of upstream llama.cpp artifacts osstat is willing to download and execute, each with the SHA256 it must match. Changing this file changes what osstat will run, so it is reviewed as data.",
  "type": "object",
  "required": ["version", "upstreamRepo", "upstreamTag", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Schema version of this file.",
      "type": "integer",
      "const": 1
    },
    "upstreamRepo": {
      "description": "The GitHub repository releases are fetched from, as owner/name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "upstreamTag": {
      "description": "The single release tag every artifact here comes from.",
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "description": "Every build osstat pins.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": {
      "description": "Lower-case hex SHA256. Upper case is rejected so comparison never needs normalising.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "companion": {
      "description": "A second archive an artifact cannot run without. Only Windows CUDA has one.",
      "type": "object",
      "required": ["file", "sha256", "sizeBytes"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "os", "arch", "backend", "file", "sha256", "sizeBytes"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable identifier, matching Backend::artifact_id in select.rs.",
          "type": "string",
          "minLength": 1
        },
        "os": { "enum": ["windows", "linux", "macos"] },
        "arch": { "enum": ["x64", "arm64"] },
        "backend": { "enum": ["metal", "cuda124", "cuda133", "vulkan", "cpu"] },
        "file": {
          "description": "Filename within the upstream release.",
          "type": "string",
          "minLength": 1
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": {
          "description": "Size in bytes, used for the disk-space check before downloading.",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "companion": { "$ref": "#/$defs/companion" }
      }
    }
  }
}
