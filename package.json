{
  "name": "osstat-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Repository tooling for osstat (formatting, commit linting, Tauri CLI)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,yml,yaml,md}": "prettier --write",
    "*.rs": [
      "rustfmt --edition 2024"
    ]
  }
}
